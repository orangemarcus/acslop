generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── NextAuth Models ─────────────────────────────────

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  plan             String    @default("free") // "free" | "pro"
  stripeCustomerId String?   @unique
  isAdmin          Boolean   @default(false)
  createdAt        DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  translations  Translation[]
  usageLogs     UsageLog[]
  sharedReports ShareableReport[]
  subscription  Subscription?
  apiKeys       ApiKey[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App Models ──────────────────────────────────────

model Translation {
  id          String   @id @default(cuid())
  userId      String
  inputText   String
  level       Int      @default(4)
  result      String   // JSON blob of TranslateResponse
  slopScore   Int      @default(0)
  createdAt   DateTime @default(now())

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares ShareableReport[]

  @@index([userId, createdAt])
}

model ShareableReport {
  id            String   @id @default(cuid())
  shareId       String   @unique // Short unique URL slug
  translationId String
  userId        String
  title         String?  // Optional custom title
  views         Int      @default(0)
  createdAt     DateTime @default(now())

  translation Translation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shareId])
  @@index([userId, createdAt])
}

model UsageLog {
  id         String   @id @default(cuid())
  userId     String?
  ipAddress  String?
  endpoint   String
  inputChars Int      @default(0)
  hasImage   Boolean  @default(false)
  level      Int      @default(4)
  durationMs Int      @default(0)
  success    Boolean  @default(true)
  error      String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([ipAddress, createdAt])
}

// ─── API Keys ────────────────────────────────────────

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  name      String   // user-assigned label e.g. "My App"
  key       String   @unique // "acslop_..." hashed prefix + random
  prefix    String   // first 8 chars for display e.g. "acslop_a1b2..."
  lastUsed  DateTime?
  requests  Int      @default(0) // lifetime request count
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([key])
}

// ─── Translation Cache ───────────────────────────────

model TranslationCache {
  id        String   @id @default(cuid())
  inputHash String   @unique // SHA-256 of normalized input + level
  inputText String
  level     Int
  result    String   // JSON blob of TranslateResponse
  slopScore Int
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inputHash])
}

// ─── Billing ────────────────────────────────────────

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  stripeSubscriptionId String   @unique
  stripePriceId        String
  status               String   // "active" | "canceled" | "past_due" | "trialing"
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
